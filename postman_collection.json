						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"body\": \"Edited via the API\",\n  \"reason\": \"typo\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{base_url}}/index.php?action=api&path=v1/posts/{{post_id}}",
						"description": "Edit the created reply. \"body\" is required; \"subject\" and \"reason\" are optional. Needs modify_own (within the time limit) or modify_any. PATCH behaves the same."
					},
					"response": []
				}
